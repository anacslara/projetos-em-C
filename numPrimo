#include <stdio.h>


int main(){
    
    unsigned int num;
    int soma;
    soma=0;
    
    printf("Digite um número:");
    scanf("%d",&num);
    
    for(int i=1; i <= num; i++){
        if ((num%i) == 0){
            soma+=1;
        }
    }
    
    if (soma == 2){
        printf("o número é primo");
    }
    else
        printf("o número não é primo");
    


    return 0;
}
