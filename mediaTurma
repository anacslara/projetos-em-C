#include <stdio.h>


typedef struct{
      char nome[50];
      float nota;
   }aluno;
   aluno alunos[50]; 


int main(){
    float media=0.0;
   
    for(int i=0; i<50; i++){
        printf("nome do aluno:");
        fgets(alunos[i].nome, 50, stdin);
        printf("nota do aluno:");
        scanf("%f",&alunos[i].nota);
        media+=alunos[i].nota;
        getchar();
    }
    
    media= media/50;
    printf("%2.2f\n",media);
    
    for(int i=0; i<50; i++){
       for(int j=0; j<50; j++){
           if(alunos[i].nota > alunos[j].nota){
                aluno aux = alunos[i];
                alunos[i] = alunos[j];
                alunos[j] = aux;
            }
       }
    }
    
    printf("alunos acima da media:");
    for(int i=0; i<50; i++){
        if(alunos[i].nota > media){
        printf("\naluno:%s e nota:%2.2f", alunos[i].nome, alunos[i].nota);
        }
        else{
            break;
        }
    }


    return 0;
}
