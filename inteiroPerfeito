#include <stdio.h>

int main(){
    
    int num, soma;
    soma=0;
    
    printf("Digite um número:");
    scanf("%d",&num);
    
    for(int i=1; i<num; i++){
         if (num%i == 0){
            soma+=i;
         }
    }
   
   
    if (soma == num){
        printf("inteiro perfeito");
    }
    else
       printf("não é inteiro perfeito");

    return 0;
}
