//Lê uma frase e printa as palavras que tenham uma ou mais vogais. 

#include <stdio.h>
#include <string.h>


void sep_palavra(char aux1[], char aux2[], int *i);


int main(){
    
    char vet[100] = {'\0'};
    int i = 0; int k=0;
    
    printf("Digite uma frase:");
    fgets(vet, sizeof(vet), stdin);
    
    while(k < 100){
        char vetaux[20] = {'\0'};
        sep_palavra(vet, vetaux, &i);
        int soma = 0;
      
        for(int j=0; j<20; j++){
            if(vetaux[j] == 'a' || vetaux[j] == 'A'){
                soma++;
            }
            if(vetaux[j] == 'e' || vetaux[j] == 'E'){
                soma++;
            }
            if(vetaux[j] == 'i' || vetaux[j] == 'I'){
                soma++;
            }
            if(vetaux[j] == 'o' || vetaux[j] == 'O'){
                soma++;
            }
            if(vetaux[j] == 'u' || vetaux[j] == 'U'){
                soma++;
            }
        }
        if(soma >= 3){
            printf("%s\n", vetaux);
        }
        if (vetaux[0] == '\0') break;
        k=i;
    }


    return 0;
}


void sep_palavra(char aux1[], char aux2[], int *i){
    
    int j=0;
    
    while(aux1[*i] == ' '){
        (*i)++;
    }   
    while((aux1[*i] != ' ') && (aux1[*i] != '\n') && (aux1[*i] != '\0')){
        aux2[j] = aux1[*i];
        (*i)++;
        j++;
    }
    aux2[j]='\0';
}
