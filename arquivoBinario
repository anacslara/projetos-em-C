                    sscanf(pedido.datentrega, "%d/%d/%d", &diap, &mesp, &anop);
                    diaprev = diap + pedido.preventrega;

                    while(diaprev > 30){
                        diaprev -= 30;
                        mesp++;
                        if(mesp > 12){
                            mesp = 1;
                            anop++;
                        }
                    }
                    totalp = anop * 10000 + mesp * 100 + diaprev;

                    if(totalp >= total){
