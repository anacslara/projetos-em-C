    scanf("%d",&aux);
    getchar();
    
    while (aux>0 && aux<5){
        
        if(aux == 1){
            arq1 = fopen("clientes.dat", "rb+");
            if(arq1 == NULL){      
                printf("Erro!");
                system("pause");
                return 0;
            }
            inserircliente(arq1);
            fclose(arq1);
        }

        if(aux == 2){
