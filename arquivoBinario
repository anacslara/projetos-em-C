                    int diap, mesp, anop, totalp;
                    sscanf(pedido.datentrega, "%d/%d/%d", &diap, &mesp, &anop);
                    totalp = anop * 10000 + mesp * 100 + diap;

                    if(totalp >= total){
                        consultar(pedido);
                    }
                }
                fclose(arq2);
            }

