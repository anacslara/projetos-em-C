                    fseek(arq2, -sizeof(pedidos), SEEK_CUR);
                    inserirpedido(arq2);
                    fclose(arq2);
                    break;
                }
            }
        }

        if(aux == 3){
            FILE *arqaux = fopen("arqaux2.dat", "wb");
            arq2 = fopen("pedidos.dat", "rb");
            if(arq2 == NULL || arqaux == NULL){      
                printf("Erro!");
                system("pause");
                return 0;
            }
            char cnpjpedido[20]={'\0'};
            printf("cnpj do pedido que você deseja excluir:");
